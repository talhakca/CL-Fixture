    "components": {
        "schemas": {
            "FixtureResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "week": {
                        "type": "integer"
                    },
                    "home_team": {
                        "$ref": "#/components/schemas/TeamResource"
                    },
                    "away_team": {
                        "$ref": "#/components/schemas/TeamResource"
                    },
                    "home_team_id": {
                        "type": "integer"
                    },
                    "away_team_id": {
                        "type": "integer"
                    },
                    "home_goals": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "away_goals": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "is_played": {
                        "type": "boolean"
                    },
                    "played_at": {
                        "type": "string"
                    },
                    "winner_team_id": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "week",
                    "home_team_id",
                    "away_team_id",
                    "home_goals",
                    "away_goals",
                    "is_played",
                    "played_at",
                    "winner_team_id"
                ],
                "title": "FixtureResource"
            },
            "PredictionRowResource": {
                "type": "object",
                "properties": {
                    "team_id": {
                        "type": "integer"
                    },
                    "team_name": {
                        "type": "string"
                    },
                    "championship_probability": {
                        "type": "number"
                    }
                },
                "required": [
                    "team_id",
                    "team_name",
                    "championship_probability"
                ],
                "title": "PredictionRowResource"
            },
            "StandingsRowResource": {
                "type": "object",
                "properties": {
                    "team_id": {
                        "type": "integer"
                    },
                    "team_name": {
                        "type": "string"
                    },
                    "played": {
                        "type": "integer"
                    },
                    "won": {
                        "type": "integer"
                    },
                    "drawn": {
                        "type": "integer"
                    },
                    "lost": {
                        "type": "integer"
                    },
                    "goals_for": {
                        "type": "integer"
                    },
                    "goals_against": {
                        "type": "integer"
                    },
                    "goal_difference": {
                        "type": "integer"
                    },
                    "points": {
                        "type": "integer"
                    }
                },
                "required": [
                    "team_id",
                    "team_name",
                    "played",
                    "won",
                    "drawn",
                    "lost",
                    "goals_for",
                    "goals_against",
                    "goal_difference",
                    "points"
                ],
                "title": "StandingsRowResource"
            },
            "TeamResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "attack_strength": {
                        "type": "integer"
                    },
                    "defense_strength": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "attack_strength",
                    "defense_strength"
                ],
                "title": "TeamResource"
            },
            "TournamentResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "settings": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {}
                    },
                    "started_at": {
                        "type": "string"
                    },
                    "total_weeks": {
                        "type": "string"
                    },
                    "last_played_week": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "settings",
                    "started_at",
                    "total_weeks",
                    "last_played_week"
                ],
                "title": "TournamentResource"
            },
            "UpdateFixtureScoreRequest": {
                "type": "object",
                "description": "Validates the manual-score-edit endpoint.\n\nGoals are bounded at 20 \u2014 a generous ceiling that filters out absurd\ninput but doesn't pretend to legislate football reality. (The simulator\nitself will essentially never produce > 7 from \u03bb \u2264 3.)",
                "properties": {
                    "home_goals": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 20
                    },
                    "away_goals": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 20
                    }
                },
                "required": [
                    "home_goals",
                    "away_goals"
                ],
                "title": "UpdateFixtureScoreRequest"
            }
        },
        "responses": {
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}