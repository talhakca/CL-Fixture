                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "health",
                "summary": "Liveness probe",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
