                ],
                "parameters": [
                    {
                        "name": "tournament",
                        "in": "path",
                        "required": true,
                        "description": "The tournament ID",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`TournamentResource`",
                        "content": {
                            "application/json": {
                                "schema": {
