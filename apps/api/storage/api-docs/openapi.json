        "/tournaments/{tournament}/standings/{week}": {
            "get": {
                "operationId": "tournaments.standings.show",
                "summary": "Standings AS OF the end of the given week \u2014 used by the frontend's\nWeekProgressBar to replay season state",
                "tags": [
                    "Standings"
                ],
                "parameters": [
                    {
                        "name": "tournament",
                        "in": "path",
                        "required": true,
                        "description": "The tournament ID",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "week",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `StandingsRowResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/StandingsRowResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
