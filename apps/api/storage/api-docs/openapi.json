            "post": {
                "operationId": "tournaments.store",
                "tags": [
                    "Tournament"
                ],
                "responses": {
                    "200": {
                        "description": "`TournamentResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/TournamentResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
