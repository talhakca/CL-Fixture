                                                    "type": "array",
                                                    "items": {}
                                                },
                                                "previous_predictions": {
                                                    "type": "array",
                                                    "items": {}
                                                }
                                            },
                                            "required": [
                                                "week",
                                                "previous_standings",
                                                "previous_predictions"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/tournaments/{tournament}/play-all": {
            "post": {
                "operationId": "tournaments.play-all",
                "tags": [
                    "Game"
                ],
                "parameters": [
                    {
                        "name": "tournament",
                        "in": "path",
                        "required": true,
                        "description": "The tournament ID",
